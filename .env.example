# ---------------------------------------------------------------------------
# FTSE 50 Market News Research Agent — configuration template
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Ollama (paid API key) — used ONLY for the final per-company analysis ---
# Base URL of the Ollama OpenAI-compatible endpoint, e.g.:
#   https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- SearXNG (primary search, self-hosted, no key needed) ---
# Point at your own instance, e.g. http://localhost:8080 or https://search.example.com
SEARXNG_BASE_URL=http://localhost:8080

# --- You.com (fallback search, used ONLY when SearXNG is insufficient) ---
# Get a key at https://you.com — only required if you want the fallback path.
YOU_API_KEY=

# --- Optional pipeline tuning (sane defaults are used when unset) ---
# MAX_ARTICLES_PER_COMPANY=10
# TOP_N_ARTICLES=3
# DEDUP_SIMILARITY_THRESHOLD=0.85
# NEWS_LOOKBACK_DAYS=14
# MAX_SEARCH_CONCURRENCY=4
# MAX_CRAWL_CONCURRENCY=3
# MAX_LLM_CONCURRENCY=2
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CACHE_DIR=data/cache
# OUTPUT_DIR=data/output

# ---------------------------------------------------------------------------
# Research stack (research-stack/, guide-aligned) — see README "Research Stack".
# docker compose reads these from research-stack/.env (never commit it).
# ---------------------------------------------------------------------------
# Secret for the SearXNG container; overrides server.secret_key. Generate: openssl rand -hex 32
SEARXNG_SECRET=
# Passed to SearXNG as SEARXNG_LIMITER (overrides server.limiter; false for our private, app-only instance)
SEARXNG_LIMITER=false
# Qdrant collection name; passed into the app container by docker-compose.yml
QDRANT_COLLECTION=research_chunks
# VALKEY_URL / QDRANT_URL are only for running research_agent OUTSIDE compose (e.g. the CLI on the host):
# compose sets them to redis://valkey:6379/1 and http://qdrant:6333 inside the stack. Valkey publishes no
# host port by design, so VALKEY_URL below only works if you add one or run inside the compose network.
VALKEY_URL=redis://localhost:6379/1
QDRANT_URL=http://localhost:6333
# Optional (all passed into the app container by compose): embedding / reranker models and device (cpu or cuda)
# EMBED_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# MODEL_DEVICE=cpu
# Self-hosted LLM served by the `ollama` service. Default qwen2.5:14b-instruct needs ~9 GB RAM; on a small
# CPU-only box use e.g. qwen2.5:3b-instruct (then: docker exec ollama ollama pull <model>)
# LLM_MODEL=qwen2.5:14b-instruct
# Optional tuning, all passed into the stack by compose (defaults shown). On a slow CPU-only machine raise
# LLM_TIMEOUT and lower MAX_ROUNDS / TOP_K_PASSAGES so a run finishes in reasonable time.
# LLM_TIMEOUT=300
# MAX_ROUNDS=3
# TOP_K_PASSAGES=14
# OLLAMA_CONTEXT_LENGTH=8192

# --- Background jobs (RabbitMQ broker + Celery worker) ---------------------------------------------
# RabbitMQ credentials are NOT read from research-stack/.env. Run research-stack/tools/init_rabbitmq_secret.sh
# once: it writes a random password to research-stack/.env.rabbitmq (git-ignored, mode 600).
# The broker has no published port and no management UI.
# Optional tuning (all passed into the app/worker containers by docker-compose.yml):
# WORKER_CONCURRENCY=1       # jobs in parallel; each worker process loads its own embedder+reranker (~4-5 GB RAM)
# WORKER_MEM_LIMIT=8g
# MAX_TOTAL_QUERIES=10       # hard cap on SearXNG queries per research job (all rounds)
# JOB_MAX_RETRIES=2          # retries (with backoff) for transient infrastructure errors only
# JOB_SOFT_TIME_LIMIT=2400   # seconds; JOB_TIME_LIMIT=2700 is the hard kill
